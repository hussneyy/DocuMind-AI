# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file — only .env.example is tracked in git.

# --- Database (used by docker-compose.yml) ---
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_dev_local_only

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
# Full connection string the API reads via ConnectionStrings__Postgres.
# For local `dotnet run` development, prefer `dotnet user-secrets set "ConnectionStrings:Postgres" "..."`
# instead of putting this in a committed file.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=documind;Username=documind;Password=documind_dev_local_only

# --- Authentication ---
# Symmetric signing key for auth tokens/cookies. Generate a strong random value per environment.
AUTH_SIGNING_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# --- AI provider (language model) ---
# Supported: "Mock" (no external calls, deterministic responses for dev/testing), "OpenAI", "Anthropic", "AzureOpenAI"
AI_PROVIDER=Mock
AI_API_KEY=
AI_API_ENDPOINT=
AI_MODEL=

# --- Embedding provider ---
# Supported: "Mock" (deterministic local vectors for dev/testing), "OpenAI", "AzureOpenAI"
EMBEDDING_PROVIDER=Mock
EMBEDDING_API_KEY=
EMBEDDING_API_ENDPOINT=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# --- Document upload limits ---
MAX_UPLOAD_SIZE_MB=25
MAX_PAGE_COUNT=500

# --- Storage ---
# Local filesystem directory for private document storage in development.
STORAGE_DIRECTORY=./storage
