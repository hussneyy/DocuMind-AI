# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file — only .env.example is tracked in git.

# --- Database (used by docker-compose.yml) ---
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_dev_local_only

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
# Full connection string the API reads via ConnectionStrings__Postgres.
# For local `dotnet run` development, prefer `dotnet user-secrets set "ConnectionStrings:Postgres" "..."`
# instead of putting this in a committed file.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=documind;Username=documind;Password=documind_dev_local_only

# --- Authentication ---
# Cookie-based auth via ASP.NET Core Identity — no signing key to configure here. In a real
# deployment with more than one instance, configure a shared Data Protection key ring (e.g.
# a shared file path or Azure Key Vault) so cookies issued by one instance validate on another.

# --- Embedding provider (ASP.NET Core double-underscore env-var binding) ---
# "Mock" (default): deterministic hashed-bag-of-words vectors, no external calls, no API key
# needed — good enough to exercise real retrieval (ranking, thresholds, hybrid fusion) but has no
# real semantic understanding. "OpenAI": calls the real embeddings endpoint; requires an API key.
Embedding__Provider=Mock
Embedding__Model=mock-bow-v1
Embedding__Dimensions=256
Embedding__ApiKey=
Embedding__Endpoint=
Embedding__TimeoutSeconds=30
Embedding__MaxRetries=2
# For real OpenAI embeddings instead, use something like:
# Embedding__Provider=OpenAI
# Embedding__Model=text-embedding-3-small
# Embedding__Dimensions=1536
# Embedding__ApiKey=sk-...

# --- Semantic/keyword/hybrid search ---
Search__DefaultTopK=10
Search__MaxTopK=50
# Minimum cosine similarity (0-1) for a semantic match to be considered relevant at all. Also the
# floor the RAG chat pipeline uses to decide whether to call the LLM at all (see Rag__* below).
Search__MinSimilarity=0.15

# --- LLM / chat-completion provider (ASP.NET Core double-underscore env-var binding) ---
# "Mock" (default): deterministic, grounded, no external calls, no API key needed — picks the
# most question-relevant sentence from each retrieved passage and cites it. Good enough to
# exercise the full RAG pipeline (grounding, citation validation, refusal-when-unsupported) but
# cannot paraphrase or truly reason the way a real model would. "OpenAI": calls the real chat
# completions endpoint; requires an API key.
Llm__Provider=Mock
Llm__Model=mock-grounded-v1
Llm__ApiKey=
Llm__Endpoint=
Llm__TimeoutSeconds=60
Llm__MaxRetries=2
Llm__Temperature=0.2
Llm__MaxOutputTokens=800
# For a real OpenAI chat model instead, use something like:
# Llm__Provider=OpenAI
# Llm__Model=gpt-4o-mini
# Llm__ApiKey=sk-...

# --- RAG question answering ---
# How many retrieved chunks to offer the model as context for one question.
Rag__ContextTopK=5
# How many prior messages from the same conversation to replay to the model for follow-ups.
Rag__MaxHistoryMessages=10

# --- Document summaries ---
# Detailed summaries use up to this many chunks, in document order (bounds prompt size for large
# documents). Short/KeyPoints instead sample this many chunks evenly spaced across the whole
# document, so a short summary isn't biased toward just the introduction.
Summary__DetailedMaxChunks=40
Summary__ShortSampleSize=6
Summary__KeyPointsSampleSize=8

# --- Document upload limits (bytes / page count) ---
Upload__MaxFileSizeBytes=26214400
Upload__MaxPageCount=500

# --- Storage ---
# Private, non-web-accessible local filesystem directory for uploaded documents.
Storage__Directory=./storage

# --- Rate limiting ---
RateLimiting__Auth__PermitLimit=10
RateLimiting__Auth__WindowSeconds=60
