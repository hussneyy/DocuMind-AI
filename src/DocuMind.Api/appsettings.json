{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=documind;Username=CHANGE_ME;Password=CHANGE_ME"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Upload": {
    "MaxFileSizeBytes": 26214400,
    "MaxPageCount": 500
  },
  "Storage": {
    "Directory": "./storage"
  },
  "Chunking": {
    "ChunkSizeChars": 1000,
    "ChunkOverlapChars": 150
  },
  "Indexing": {
    "PollIntervalSeconds": 2,
    "BatchSize": 5,
    "MaxConcurrency": 2
  },
  "Embedding": {
    "Provider": "Mock",
    "Model": "mock-bow-v1",
    "Dimensions": 256,
    "ApiKey": "",
    "Endpoint": "",
    "TimeoutSeconds": 30,
    "MaxRetries": 2
  },
  "Search": {
    "DefaultTopK": 10,
    "MaxTopK": 50,
    "MinSimilarity": 0.15
  },
  "Llm": {
    "Provider": "Mock",
    "Model": "mock-grounded-v1",
    "ApiKey": "",
    "Endpoint": "",
    "TimeoutSeconds": 60,
    "MaxRetries": 2,
    "Temperature": 0.2,
    "MaxOutputTokens": 800
  },
  "Rag": {
    "ContextTopK": 5,
    "MaxHistoryMessages": 10
  },
  "Summary": {
    "DetailedMaxChunks": 40,
    "ShortSampleSize": 6,
    "KeyPointsSampleSize": 8
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Upload": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Ai": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  }
}
